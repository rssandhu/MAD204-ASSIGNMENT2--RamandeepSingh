    DashboardActivity Layout: Displays welcome message and buttons to Profile, Countries List,
    Settings, and Logout functionality.
-->

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Welcome message text view -->

    <!-- Button to navigate to ProfileActivity -->

    <TextView
        android:id="@+id/textViewWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="124dp"
        android:text="Welcome, User"
        android:textAlignment="center"
        android:textAppearance="@style/LargeLabel"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/buttonProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Profile"
        style="@style/PrimaryButton"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/textViewWelcome"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginHorizontal="32dp"/>

    <!-- Button to navigate to Countries ListActivity -->
    <Button
        android:id="@+id/buttonCountries"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Countries List"
        style="@style/PrimaryButton"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/buttonProfile"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginHorizontal="32dp"/>

    <!-- Button to navigate to SettingsActivity -->
    <Button
        android:id="@+id/buttonSettings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Settings"
        style="@style/PrimaryButton"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/buttonCountries"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginHorizontal="32dp"/>

    <!-- Logout Button -->
    <Button
        android:id="@+id/buttonLogout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Logout"
        style="@style/SecondaryButton"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/buttonSettings"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginHorizontal="32dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
