<resources>
    <!-- Primary button style for important actions -->
    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:backgroundTint">@color/purple_500</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Secondary button style -->
    <style name="SecondaryButton" parent="PrimaryButton">
        <item name="android:backgroundTint">@color/teal_700</item>
    </style>

    <!-- Custom text style for large labels -->
    <style name="LargeLabel" parent="TextAppearance.AppCompat.Large">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>
